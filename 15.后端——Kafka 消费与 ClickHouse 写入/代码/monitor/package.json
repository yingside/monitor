{
  "name": "monitor",
  "private": true,
  "version": "0.0.1",
  "description": "前端监控全栈实战 - Monorepo 根目录",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "type-check": "turbo run type-check",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,vue,js,mjs,json}\"",
    "spellcheck": "cspell lint --no-progress --show-suggestions --no-summary --no-color \"(packages|apps)/**/*.{js,ts,mjs,cjs,json,tsx,css,less,scss,vue,html,md}\"",
    "mock-server": "node --experimental-strip-types demos/mock-server/server.ts",
    "collect-server": "node --experimental-strip-types demos/collect-server/server.ts",
    "dsn-server": "pnpm --filter @monitor/dsn-server dev",
    "consumer-server": "pnpm --filter @monitor/consumer-server dev",
    "infra:start": "docker compose -f docker/docker-compose.yml --env-file docker/.env up -d",
    "infra:stop": "docker compose -f docker/docker-compose.yml --env-file docker/.env stop",
    "infra:reset": "docker compose -f docker/docker-compose.yml --env-file docker/.env down -v",
    "infra:logs": "docker compose -f docker/docker-compose.yml --env-file docker/.env logs -f"
  },
  "devDependencies": {
    "@cspell/dict-lorem-ipsum": "^4.0.0",
    "@eslint/js": "^9.0.0",
    "@types/node": "^20.19.40",
    "cspell": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "eslint-plugin-vue": "^9.0.0",
    "prettier": "^3.0.0",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.0.0",
    "vue-eslint-parser": "^9.0.0"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
