# Monitor Server 环境变量说明
# 复制本文件为 .env，填写真实值后启动服务

# ── 服务端口 ──────────────────────────────────────────────────────────────────
PORT=3003

# ── PostgreSQL 连接（用户 & 项目业务数据） ────────────────────────────────────
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=monitor
PG_USER=monitor
PG_PASSWORD=123456

# ── ClickHouse 连接（监控数据查询） ────────────────────────────────────────────
CLICKHOUSE_HOST=http://localhost:8123
CLICKHOUSE_DATABASE=monitor
CLICKHOUSE_USER=monitor
CLICKHOUSE_PASSWORD=123456

# ── JWT 配置 ──────────────────────────────────────────────────────────────────
# JWT_SECRET 生产环境必须替换为高熵随机字符串（建议 64 字节以上）
# 可用命令生成：openssl rand -hex 64
JWT_SECRET=monitor_dev_secret_change_in_production
# Token 有效期（支持 ms 库格式：7d / 24h / 3600s）
JWT_EXPIRES_IN=7d
