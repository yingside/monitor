# =============================================================================
# DSN Server · 环境变量配置模板
# =============================================================================
# 说明：
#   复制本文件为 .env，填入实际值后运行服务
#   cp .env.example .env
# =============================================================================

# 服务监听端口（默认 3000）
PORT=3000

# Kafka Broker 地址（多个 Broker 用逗号分隔）
# 本地开发：Kafka 容器通过 9094 端口暴露给宿主机，NestJS 用此地址连接
KAFKA_BROKERS=localhost:9094

# 合法的 appId 白名单（逗号分隔）
# 留空则跳过 appId 校验（适合本地开发阶段）
# 第 16 章接入 PostgreSQL 后此配置将被替换为数据库查询
VALID_APP_IDS=vue3-demo,react-demo
