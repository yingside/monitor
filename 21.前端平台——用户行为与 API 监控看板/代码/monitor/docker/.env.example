# =============================================================================
# 前端监控全栈实战 · 基础设施环境变量模板
# =============================================================================
# 说明：
#   复制此文件为 .env，填入实际值后再启动 docker-compose
#   cp .env.example .env
# =============================================================================

# PostgreSQL
POSTGRES_PORT=5432
POSTGRES_DB=monitor
POSTGRES_USER=
POSTGRES_PASSWORD=

# ClickHouse
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_DB=monitor
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=

# Kafka
KAFKA_EXTERNAL_PORT=9094

# Kafka UI
KAFKA_UI_PORT=8081
