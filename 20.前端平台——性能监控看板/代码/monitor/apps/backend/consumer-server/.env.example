# Consumer Server 环境变量配置

# ── Kafka ──────────────────────────────────────────────────────────────────
# Kafka Broker 地址（多个地址逗号分隔）
# 本地开发：Kafka 容器对宿主机暴露 9094 端口
# 容器内互访：使用 kafka:9092（第 23 章部署阶段改用）
KAFKA_BROKERS=localhost:9094

# Kafka Consumer Group ID
# 同一个 Group 内的多个 Consumer 实例共享消费进度（分区负载均衡）
# 本课程只运行一个 Consumer 实例，GroupId 主要用于 Kafka UI 中区分不同消费者
KAFKA_GROUP_ID=monitor-consumer-group

# ── ClickHouse ─────────────────────────────────────────────────────────────
# ClickHouse HTTP 服务地址（@clickhouse/client 默认使用 HTTP 协议，端口 8123）
CLICKHOUSE_HOST=http://localhost:8123
CLICKHOUSE_DATABASE=monitor
CLICKHOUSE_USER=monitor
CLICKHOUSE_PASSWORD=123456

# ── 服务端口 ────────────────────────────────────────────────────────────────
# Consumer Server 本身提供一个极简 HTTP 接口用于健康检查
PORT=3001
